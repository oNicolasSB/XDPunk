# lb_chain_real.env — configuracao da topologia encadeada A-R1-{R2,R3}-R4-B
# em 6 VMs reais (Proxmox). Lido (source) pelos scripts *_lb_chain_real*.sh
# e pelos benchmarks experiments/*_lb_*_real.sh. Ver
# docs/setup_xdp_lb_chain_real.md.
#
#   host1 ens19 ── ens19 R1 ens20 ── ens19 R2 ens20 ── ens21 R4 eth1 ── ens19 host2
#                        R1 ens21 ── eth1  R3 ens20 ── ens20 R4
#
# Cada enlace e um segmento L2 isolado (VLAN propria no Proxmox).
# Variaveis ja definidas no ambiente tem precedencia.

: "${SSH_USER:=nicolas}"

# Gerencia (SSH)
: "${H1_MGMT:=10.20.241.143}"
: "${H2_MGMT:=10.20.241.134}"
: "${R1_MGMT:=10.20.241.210}"
: "${R2_MGMT:=10.20.241.209}"
: "${R3_MGMT:=10.20.241.214}"
: "${R4_MGMT:=10.20.241.212}"

# Enderecamento de dados (mesmo do lab em netns, setup_xdp_lb_chain.sh)
: "${A_IP:=10.10.1.1}"
: "${B_IP:=10.10.2.1}"
: "${GW_A_IP:=10.10.1.254}"
: "${GW_B_IP:=10.10.2.254}"
: "${NET_A:=10.10.1.0/24}"
: "${NET_B:=10.10.2.0/24}"

# Interfaces de dados (W0 = link via R2, W1 = link via R3)
: "${H1_IF:=ens19}"
: "${H2_IF:=ens19}"
: "${R1_LAN:=ens19}"
: "${R1_W0:=ens20}"
: "${R1_W1:=ens21}"
: "${R2_A:=ens19}"   # R2 -> R1
: "${R2_B:=ens20}"   # R2 -> R4
: "${R3_A:=eth1}"    # R3 -> R1
: "${R3_B:=ens20}"   # R3 -> R4
: "${R4_LAN:=eth1}"
: "${R4_W0:=ens21}"
: "${R4_W1:=ens20}"

# Enlaces ponto a ponto /30
: "${R1_W0_IP:=172.20.1.1}"
: "${R2_A_IP:=172.20.1.2}"
: "${R1_W1_IP:=172.20.2.1}"
: "${R3_A_IP:=172.20.2.2}"
: "${R2_B_IP:=172.20.3.1}"
: "${R4_W0_IP:=172.20.3.2}"
: "${R3_B_IP:=172.20.4.1}"
: "${R4_W1_IP:=172.20.4.2}"

# Diretorio (relativo ao HOME remoto) para onde os scripts sao copiados
: "${REMOTE_DIR:=xdpunk}"

# Execucao remota como root, com PATH que inclui xdpunk-cli/bpftool/ethtool
lbr_ssh() {  # lbr_ssh <ip_gerencia> <comando (string)>
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_USER@$1" \
    "sudo env PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin bash -c $(printf '%q' "$2")"
}

lbr_mac() {  # lbr_mac <ip_gerencia> <iface>
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_USER@$1" "cat /sys/class/net/$2/address"
}
